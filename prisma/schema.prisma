generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PushbirdDevice {
  id                Int     @id @default(autoincrement())
  nome              String
  webhookUrl        String
  notificarConflito Boolean @default(true) // liberação de servo (MFA de conflito ao adicionar)
  notificarCerco    Boolean @default(true) // pessoa escolheu horário no Cerco de Jericó
  notificarQuadrante Boolean @default(true) // servo adicionado, recusou, desistiu ou excluído
}

model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String  @unique
  senha String? // hash bcrypt; null para contas criadas via login Google
  role  String  @default("ADMIN") // SUPER | ADMIN | COORDENADOR
  setor String? // só para COORDENADOR: nome do setor (igual a Setor.nome / Servo.setor)
  sessaoVersao Int @default(0) // incrementa no logout/troca de senha → invalida tokens de sessão antigos

  missoes UsuarioMissao[]
}

model Missao {
  id            Int    @id @default(autoincrement())
  nome          String
  tipo          String // MIRIM | FAC | JUVENIL | SENIOR | CASAIS
  ano           Int
  cercoSlug     String @unique
  valorInterna  Float  @default(160)
  valorExterna  Float  @default(80)
  valorCampista Float  @default(300)
  cercoPublicado Boolean @default(true)
  cercoMaxPorHorario Int @default(15) // vagas por hora no Cerco de Jericó
  mes           Int?    // mês real do acampamento (1-12) — só para checagem de proximidade entre missões
  anoCalendario Int?    // ano-calendário real (ex: 2026) — não confundir com o campo `ano` (edição), que não muda
  dataInicio    String? // YYYY-MM-DD — saída do acampamento (usada nas fichas)
  dataFim       String? // YYYY-MM-DD — encerramento do acampamento (usada nas fichas)
  pixChave      String? // chave PIX da inscrição (usada nas fichas)
  contatoFinanceiro String? // telefone do Setor Financeiro (usado nas fichas)

  servos       Servo[]
  neocampistas Neocampista[]
  tribos       Tribo[]
  usuarios     UsuarioMissao[]
  liberacoesConflito LiberacaoConflitoServo[]
  evangelizacaoFechada Boolean @default(false) // distribuição das casas fechada (só SUPER reabre)
  equipesEvangelizacao EquipeEvangelizacao[]
}

// vínculo de acesso: quais missões um usuário ADMIN pode ver/editar (SUPER não usa isso)
model UsuarioMissao {
  usuarioId Int
  missaoId  Int

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  missao  Missao  @relation(fields: [missaoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, missaoId])
}

model Pessoa {
  id       Int     @id @default(autoincrement())
  nome     String
  cpf      String?
  celular  String?
  endereco String?
  bairro   String?
  cidade   String?
  paroquia String?
  sexo        String?
  camiseta    String?
  email       String?
  aniversario String?

  servos Servo[]
  liberacoesConflito LiberacaoConflitoServo[]
}

model Servo {
  id       Int @id @default(autoincrement())
  missaoId Int
  pessoaId Int

  setor          String
  funcao         String  @default("INTEGRANTE") // COORDENADOR | AUXILIAR | APOIO | INTEGRANTE
  camiseta       String?
  status         String  @default("ATIVO") // ATIVO | RECUSOU | DESISTIU
  confirmado     Boolean @default(false) // coordenador de setor confirmou o "Sim" (ATIVO sem confirmar = ainda será chamado)
  formacao1      String? // SIM | Não
  formacao2      String?
  formacao3      String?
  motivoFalta    String?
  pagamentoForma String? // DINHEIRO | PIX | ISENTO | ...
  pagamentoValor Float?
  pago           Boolean @default(false)
  observacoes    String?
  cercoHorario   String? // "00:00 - 01:00" ... ou null
  motivoDesistiu String?
  motivoRecusou  String?
  temCarro       Boolean @default(false)
  equipeEvangelizacaoId Int?

  missao Missao @relation(fields: [missaoId], references: [id])
  pessoa Pessoa @relation(fields: [pessoaId], references: [id])
  equipeEvangelizacao EquipeEvangelizacao? @relation("servosEquipe", fields: [equipeEvangelizacaoId], references: [id], onDelete: SetNull)

  tribosLideradas TriboLider[]

  @@unique([missaoId, pessoaId])
  @@index([missaoId, setor])
  @@index([pessoaId])
  @@index([equipeEvangelizacaoId])
}

model Neocampista {
  id       Int @id @default(autoincrement())
  missaoId Int
  numero   Int // número da ficha

  nucleo      String
  nome        String
  endereco    String?
  bairro      String?
  cidade      String?
  celular     String?
  idade       Int?
  altura      Float?
  peso        Float?
  sexo        String?
  camiseta    String?
  pagamento   String?
  situacao    String  @default("OK")
  observacao  String?
  cpf         String?
  triboId     Int?
  equipeEvangelizacaoId Int?
  casaFixada  Boolean @default(false)

  missao  Missao  @relation(fields: [missaoId], references: [id])
  tribo   Tribo?  @relation(fields: [triboId], references: [id])
  equipeEvangelizacao EquipeEvangelizacao? @relation("casasEquipe", fields: [equipeEvangelizacaoId], references: [id], onDelete: SetNull)
  alertas FichaAlerta[] @relation("alertaOrigem")
  alvos   FichaAlerta[] @relation("alertaAlvo")

  @@unique([missaoId, numero])
  @@index([triboId])
  @@index([equipeEvangelizacaoId])
}

// par de fichas que não podem ficar na mesma tribo (parentesco/amizade)
model FichaAlerta {
  id       Int @id @default(autoincrement())
  origemId Int
  alvoId   Int

  origem Neocampista @relation("alertaOrigem", fields: [origemId], references: [id])
  alvo   Neocampista @relation("alertaAlvo", fields: [alvoId], references: [id])

  @@unique([origemId, alvoId])
}

model Tribo {
  id       Int    @id @default(autoincrement())
  missaoId Int
  nome     String // TRIBO AZUL ...
  cor      String?

  missao       Missao        @relation(fields: [missaoId], references: [id])
  neocampistas Neocampista[]
  lideres      TriboLider[]

  @@unique([missaoId, nome])
}

model TriboLider {
  id      Int @id @default(autoincrement())
  triboId Int
  servoId Int

  tribo Tribo @relation(fields: [triboId], references: [id])
  servo Servo @relation(fields: [servoId], references: [id])

  @@unique([triboId, servoId])
}

// par de pessoas marcado como "não é duplicata" na tela de possíveis duplicatas
model DuplicataIgnorada {
  id       Int @id @default(autoincrement())
  pessoa1Id Int
  pessoa2Id Int

  @@unique([pessoa1Id, pessoa2Id])
}

// domínios (aba Base de Dados)
model Setor {
  id   Int    @id @default(autoincrement())
  nome String @unique
}

model Nucleo {
  id   Int    @id @default(autoincrement())
  nome String @unique
}

// aba Procv: cidade+bairro -> paróquia
model Paroquia {
  id       Int    @id @default(autoincrement())
  cidade   String
  bairro   String
  paroquia String

  @@unique([cidade, bairro])
}

// código de liberação temporário pra cadastrar servo ATIVO em missão com conflito de proximidade
model LiberacaoConflitoServo {
  id       Int      @id @default(autoincrement())
  pessoaId Int
  missaoId Int // missão de destino onde o servo está sendo cadastrado
  codigo   String
  criadoEm DateTime @default(now())
  expiraEm DateTime
  usado    Boolean  @default(false)

  pessoa Pessoa @relation(fields: [pessoaId], references: [id])
  missao Missao @relation(fields: [missaoId], references: [id])

  @@index([pessoaId, missaoId])
}

// Evangelização: cidade canônica (grafias sujas viram apelidos), vizinhança e equipes
model Cidade {
  id   Int    @id @default(autoincrement())
  nome String @unique

  apelidos  CidadeApelido[]
  vizinhas  CidadeVizinha[] @relation("cidadeOrigem")
  vizinhaDe CidadeVizinha[] @relation("cidadeVizinha")
}

model CidadeApelido {
  id       Int    @id @default(autoincrement())
  apelido  String @unique // normalizarCidade(texto)
  cidadeId Int

  cidade Cidade @relation(fields: [cidadeId], references: [id], onDelete: Cascade)

  @@index([cidadeId])
}

// guardado nos dois sentidos
model CidadeVizinha {
  cidadeId Int
  vizinhaId Int

  cidade Cidade @relation("cidadeOrigem", fields: [cidadeId], references: [id], onDelete: Cascade)
  vizinha Cidade @relation("cidadeVizinha", fields: [vizinhaId], references: [id], onDelete: Cascade)

  @@id([cidadeId, vizinhaId])
  @@index([vizinhaId])
}

model EquipeEvangelizacao {
  id       Int     @id @default(autoincrement())
  missaoId Int
  nome     String
  manual   Boolean @default(false) // criada ou editada à mão: "Sugerir equipes" não apaga nem refaz

  missao Missao        @relation(fields: [missaoId], references: [id], onDelete: Cascade)
  servos Servo[]       @relation("servosEquipe")
  casas  Neocampista[] @relation("casasEquipe")

  @@index([missaoId])
}
